# ===================================
# CBAM Guard - Environment Variables
# ===================================
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin

# ===================================
# Uygulama Ayarları
# ===================================
APP_NAME=CBAM Guard
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# ===================================
# Veritabanı
# ===================================
DATABASE_URL=sqlite:///./cbam_guard.db
# PostgreSQL için:
# DATABASE_URL=postgresql://user:password@localhost:5432/cbam_guard

# ===================================
# API Ayarları
# ===================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ===================================
# AI / LLM Ayarları (Opsiyonel)
# ===================================
# OPENAI_API_KEY=sk-your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# LLM_MODEL=gpt-4

# ===================================
# E-posta Ayarları (Opsiyonel)
# ===================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ===================================
# Redis Cache (Opsiyonel)
# ===================================
# REDIS_URL=redis://localhost:6379/0

# ===================================
# Logging
# ===================================
LOG_LEVEL=INFO
LOG_FILE=logs/cbam_guard.log
